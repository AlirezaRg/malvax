{
  "uid": "malvax-overview",
  "title": "MalvaX overview",
  "tags": ["malvax"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Samples accepted (total)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"refId": "A", "expr": "sum(malvax_samples_total)"}]
    },
    {
      "id": 2, "type": "stat", "title": "Analyses completed (total)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"refId": "A", "expr": "sum(malvax_analysis_jobs_total{state=\"COMPLETED\"})"}]
    },
    {
      "id": 3, "type": "stat", "title": "Analyses failed (total)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"refId": "A", "expr": "sum(malvax_analysis_failures_total)"}]
    },
    {
      "id": 4, "type": "stat", "title": "Workers busy now",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"refId": "A", "expr": "sum(malvax_worker_active)"}]
    },
    {
      "id": 5, "type": "timeseries", "title": "Job state changes per minute",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"refId": "A", "legendFormat": "{{state}}",
                   "expr": "sum by (state) (rate(malvax_analysis_jobs_total[5m])) * 60"}]
    },
    {
      "id": 6, "type": "timeseries", "title": "Analysis duration p50 / p95 (s)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "legendFormat": "p50",
         "expr": "histogram_quantile(0.5, sum by (le) (rate(malvax_analysis_duration_seconds_bucket[15m])))"},
        {"refId": "B", "legendFormat": "p95",
         "expr": "histogram_quantile(0.95, sum by (le) (rate(malvax_analysis_duration_seconds_bucket[15m])))"}
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Findings recorded per minute",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "rate(malvax_findings_total[5m]) * 60"}]
    },
    {
      "id": 8, "type": "stat", "title": "Sandbox timeouts (0 until the sandbox is connected)",
      "description": "Zero means no sandbox runs yet, not that no timeouts happened.",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "sum(malvax_sandbox_timeouts_total)"}]
    }
  ]
}
